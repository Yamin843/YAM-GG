Result<void> JavaFacade::hook_method(u64 m,
    std::function<void(const std::vector<u64>&, u64)> cb) {
    (void)m;
    auto r = JavaHookManager::instance().hook("", "", "",
        [cb](const std::vector<u64>& a, u64 t) { cb(a, t); });
    if (!r) return Result<void>::err(r.error_code(), r.error_message());
    return Result<void>::ok();
}
Result<void> JavaFacade::unhook_method(u64) { return Result<void>::ok(); }
Result<usize> JavaFacade::choose(const String& cls, std::function<int(Handle)> on_match) {
    // Trigger choose; results arrive as events from the JS side.
    // For now we register a temporary listener on "choose_result".
    std::mutex mu;
    std::condition_variable cv;
    std::vector<u64> handles;
    bool got = false;
    events::on("choose_result", [&](const Event& ev) {
        std::lock_guard<std::mutex> lk(mu);
        if (auto* v = ev.get("handles")) {
            if (v->is_arr())
                for (auto& e : v->arr_val) handles.push_back(static_cast<u64>(e.as_i64(0)));
        }
        got = true;
        cv.notify_all();
    });
    auto r = JavaScriptBridge::instance().choose(cls);
    if (!r) return Result<usize>::err(r.error_code(), r.error_message());
    {
        std::unique_lock<std::mutex> lk(mu);
        cv.wait_for(lk, std::chrono::milliseconds(3000), [&]{ return got; });
    }
    usize count = 0;
    for (u64 h : handles) {
        HandleId hid = registry().register_entry(RegistryKind::JavaObject, cls,
                                                  reinterpret_cast<void*>(h));
        Handle handle(hid);
        ++count;
        if (on_match) {
            int rc = on_match(handle);
            if (rc != 0) break;
        }
    }
    return Result<usize>::ok(count);
}
Result<std::vector<Handle>> JavaFacade::choose_all(const String& cls) {
    (void)cls;
    return Result<std::vector<Handle>>::ok({});
}

// ===========================================================================
// SECTION 7 — JavaHookManager
// ===========================================================================

namespace {
std::atomic<i64> g_cb_id{1};
std::mutex g_hook_mu;
std::unordered_map<i64, JavaHookManager::Fn> g_hook_fns;
}

JavaHookManager::JavaHookManager() {
    JavaScriptBridge::instance().set_hook_callback(
        [](i64 id, const std::vector<u64>& args, u64 this_h) {
            JavaHookManager::Fn fn;
            { std::lock_guard<std::mutex> lk(g_hook_mu);
              auto it = g_hook_fns.find(id);
              if (it != g_hook_fns.end()) fn = it->second; }
            if (fn) {
                try { fn(args, this_h); }
                catch (const std::exception& e) {
                    YAM_LOG_ERROR() << "hook fn: " << e.what(); }
            }
        });
}
JavaHookManager::~JavaHookManager() = default;
JavaHookManager& JavaHookManager::instance() {
    static JavaHookManager inst;
    return inst;
}
Result<HandleId> JavaHookManager::hook(const String& cls, const String& method,
                                        const String& sig, Fn fn) {
    auto cr = JavaFacade::use(cls);
    if (!cr) return Result<HandleId>::err(cr.error_code(), cr.error_message());
    u64 cls_bridge = reinterpret_cast<u64>(cr.value().raw());
    auto mr = JavaFacade::method(cls_bridge, method, sig);
    if (!mr) return Result<HandleId>::err(mr.error_code(), mr.error_message());
    i64 cb_id = g_cb_id.fetch_add(1);
    { std::lock_guard<std::mutex> lk(g_hook_mu); g_hook_fns[cb_id] = std::move(fn); }
    auto hr = JavaScriptBridge::instance().hook_method(mr.value(), cb_id);
    if (!hr) {
        std::lock_guard<std::mutex> lk(g_hook_mu);
        g_hook_fns.erase(cb_id);
        return Result<HandleId>::err(hr.error_code(), hr.error_message());
    }
    HandleId id = registry().register_entry(RegistryKind::JavaMethod, cls,
                                             reinterpret_cast<void*>(mr.value()));
    return Result<HandleId>::ok(id);
}
Result<void> JavaHookManager::unhook(HandleId id) {
    auto rec = registry().lookup(id);
    if (!rec) return Result<void>::err(ErrorCode::MethodNotFound, "hook id");
    JavaScriptBridge::instance().unhook_method(
        reinterpret_cast<u64>(rec->native_handle));
    { std::lock_guard<std::mutex> lk(mu_); hooks_.erase(id); }
    return Result<void>::ok();
}
void JavaHookManager::clear() {
    std::vector<HandleId> ids;
    { std::lock_guard<std::mutex> lk(mu_);
      for (auto& p : hooks_) ids.push_back(p.first); }
    for (auto id : ids) unhook(id);
}
usize JavaHookManager::size() const {
    std::lock_guard<std::mutex> lk(mu_);
    return hooks_.size();
}

