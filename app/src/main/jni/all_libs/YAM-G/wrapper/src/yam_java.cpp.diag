Result<void> JavaScriptBridge::load_scripts_batch(const std::vector<std::pair<String,String>>& scripts) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "load_scripts_batch");
    cmd += ",\"scripts\":[";
    for (size_t i = 0; i < scripts.size(); ++i) {
        if (i) cmd += ",";
        cmd += "{\"name\":\"" + str::escape_json(scripts[i].first) +
               "\",\"code\":\"" + str::escape_json(scripts[i].second) + "\"}";
    }
    cmd += "]}";
    return send(cmd);
}
