// ===========================================================================
// SECTION 6 — JavaFacade
// ===========================================================================

Result<void> JavaFacade::start() {
    auto r = JavaScriptBridge::instance().initialize();
    if (!r) return r;
    install_event_router();
    return Result<void>::ok();
}
Result<void> JavaFacade::stop() {
    return JavaScriptBridge::instance().shutdown();
}
bool JavaFacade::is_ready() {
    return JavaScriptBridge::instance().is_ready();
}

Result<Handle> JavaFacade::use(const String& cls) {
    auto r = JavaScriptBridge::instance().use_class(cls);
    if (!r) return Result<Handle>::err(r.error_code(), r.error_message());
    if (r.value().kind != "handle")
        return Result<Handle>::err(ErrorCode::ClassNotFound, cls);
    HandleId id = registry().register_entry(RegistryKind::JavaClass, cls,
                                            reinterpret_cast<void*>(r.value().handle));
    return Result<Handle>::ok(Handle(id));
}
Result<std::vector<String>> JavaFacade::enumerate_classes() {
    // The bridge sends classes_list as an event. We register a temporary
    // listener and wait for it.
    std::mutex mu;
    std::condition_variable cv;
    std::vector<String> result;
    bool got = false;
    events::on("classes_list", [&](const Event& ev) {
        std::lock_guard<std::mutex> lk(mu);
        if (auto* v = ev.get("classes")) {
            if (v->is_arr())
                for (auto& e : v->arr_val) result.push_back(e.as_str());
        }
        got = true;
        cv.notify_all();
    });
    JavaScriptBridge::instance().enumerate_classes();
    {
        std::unique_lock<std::mutex> lk(mu);
        cv.wait_for(lk, std::chrono::milliseconds(3000), [&]{ return got; });
    }
    return Result<std::vector<String>>::ok(std::move(result));
}
Result<std::vector<String>> JavaFacade::enumerate_loaders() {
    std::mutex mu;
    std::condition_variable cv;
    std::vector<String> result;
    bool got = false;
    events::on("loaders_list", [&](const Event& ev) {
        std::lock_guard<std::mutex> lk(mu);
        if (auto* v = ev.get("loaders")) {
            if (v->is_arr())
                for (auto& e : v->arr_val) result.push_back(e.as_str());
        }
        got = true;
        cv.notify_all();
    });
    JavaScriptBridge::instance().enumerate_loaders();
    {
        std::unique_lock<std::mutex> lk(mu);
        cv.wait_for(lk, std::chrono::milliseconds(3000), [&]{ return got; });
    }
    return Result<std::vector<String>>::ok(std::move(result));
}
Result<u64> JavaFacade::method(u64 cls, const String& n, const String& s) {
    auto r = JavaScriptBridge::instance().get_method(cls, n, s);
    if (!r) return Result<u64>::err(r.error_code(), r.error_message());
    if (r.value().kind != "handle")
        return Result<u64>::err(ErrorCode::MethodNotFound, n);
    return Result<u64>::ok(r.value().handle);
}
Result<u64> JavaFacade::new_instance(u64 cls, const std::vector<u64>& args) {
    String a = "[";
    for (size_t i = 0; i < args.size(); ++i) {
        if (i) a += ",";
        a += "{\"handle\":" + std::to_string(args[i]) + "}";
    }
    a += "]";
    auto r = JavaScriptBridge::instance().new_instance(cls, a);
    if (!r) return Result<u64>::err(r.error_code(), r.error_message());
    if (r.value().kind != "handle")
        return Result<u64>::err(ErrorCode::InternalError, "new_instance");
    return Result<u64>::ok(r.value().handle);
}
Result<u64> JavaFacade::cast(u64 cls, u64 obj) {
    auto r = JavaScriptBridge::instance().cast(cls, obj);
    if (!r) return Result<u64>::err(r.error_code(), r.error_message());
    if (r.value().kind != "handle")
        return Result<u64>::err(ErrorCode::TypeError, "cast");
    return Result<u64>::ok(r.value().handle);
}
Result<JavaReply> JavaFacade::call(u64 inst, u64 method, const std::vector<u64>& args) {
    String a = "[";
    for (size_t i = 0; i < args.size(); ++i) {
        if (i) a += ",";
        a += "{\"handle\":" + std::to_string(args[i]) + "}";
    }
    a += "]";
    return JavaScriptBridge::instance().call_method(inst, method, a);
}
Result<JavaReply> JavaFacade::call_static(u64, u64 method, const std::vector<u64>& args) {
    return call(0, method, args);
}
Result<JavaReply> JavaFacade::get_field(u64 inst, u64 field) {
    return JavaScriptBridge::instance().get_field(inst, field);
}
Result<void> JavaFacade::set_field(u64 inst, u64 field, u64 value) {
    String v = "{\"handle\":" + std::to_string(value) + "}";
    auto r = JavaScriptBridge::instance().set_field(inst, field, v);
    if (!r) return Result<void>::err(r.error_code(), r.error_message());
    return Result<void>::ok();
}
