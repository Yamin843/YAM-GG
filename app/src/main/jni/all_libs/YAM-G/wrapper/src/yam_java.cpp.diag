// ---------------------------------------------------------------------------
// Parametrized commands (fire-and-forget)
// ---------------------------------------------------------------------------

Result<void> JavaScriptBridge::trace(u64 tid, const String& c, const String& m,
                                     const String& s, i32 st, i32 sk, i32 mm,
                                     bool has_ov, const String& ov) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "trace");
    cmd += jn("traceId", static_cast<i64>(tid));
    cmd += js("className", c); cmd += js("methodName", m); cmd += js("signature", s);
    cmd += jn("stackDepth", st); cmd += jn("skip", sk); cmd += jn("minMs", mm);
    if (has_ov) cmd += jr("overrideReturn", ov);
    cmd += "}";
    return send(cmd);
}
Result<void> JavaScriptBridge::trace_class(u64 tid, const String& c, const String& p,
                                            i32 st, i32 sk, i32 mm) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "trace_class");
    cmd += jn("traceId", static_cast<i64>(tid));
    cmd += js("className", c); cmd += js("pattern", p);
    cmd += jn("stackDepth", st); cmd += jn("skip", sk); cmd += jn("minMs", mm);
    cmd += "}";
    return send(cmd);
}
Result<void> JavaScriptBridge::untrace(u64 tid) {
    u64 id = next_id_.fetch_add(1);
    return send(cmd_head(id, "untrace") + jn("traceId", static_cast<i64>(tid)) + "}");
}
Result<void> JavaScriptBridge::untrace_range(u64 a, u64 b) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "untrace_range");
    cmd += jn("firstId", static_cast<i64>(a));
    cmd += jn("lastId", static_cast<i64>(b));
    cmd += "}";
    return send(cmd);
}
Result<void> JavaScriptBridge::pause(u64 tid) {
    u64 id = next_id_.fetch_add(1);
    return send(cmd_head(id, "pause") + jn("traceId", static_cast<i64>(tid)) + "}");
}
Result<void> JavaScriptBridge::resume(u64 tid) {
    u64 id = next_id_.fetch_add(1);
    return send(cmd_head(id, "resume") + jn("traceId", static_cast<i64>(tid)) + "}");
}
Result<void> JavaScriptBridge::set_param(u64 tid, i32 i, const String& t, const String& v) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "set_param");
    cmd += jn("traceId", static_cast<i64>(tid));
    cmd += jn("index", i);
    cmd += js("type", t); cmd += js("value", v);
    cmd += "}";
    return send(cmd);
}
Result<void> JavaScriptBridge::clear_param(u64 tid, i32 i) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "clear_param");
    cmd += jn("traceId", static_cast<i64>(tid));
