Result<void> JavaScriptBridge::replay(u64 rid, const String& cls, const String& m,
                                       const String& sig, bool is_static, u64 inst,
                                       const String& args, i32 times, i32 inter,
                                       bool stop_on_error) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "replay");
    cmd += jn("replayId", static_cast<i64>(rid));
    cmd += js("className", cls); cmd += js("methodName", m); cmd += js("signature", sig);
    cmd += jb("isStatic", is_static);
    cmd += jn("instanceHandle", static_cast<i64>(inst));
    cmd += jr("argsSpec", args.empty() ? "[]" : args);
    cmd += jn("times", times); cmd += jn("interleaveMs", inter);
    cmd += jb("stopOnError", stop_on_error);
    cmd += "}";
    return send(cmd);
}
