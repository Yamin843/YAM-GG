Result<void> JavaScriptBridge::call(u64 call_id, const String& cls, const String& m,
                                    const String& sig, bool is_static, u64 inst,
                                    const String& args_json, const String& mod_fields) {
    u64 id = next_id_.fetch_add(1);
    String cmd = cmd_head(id, "call");
    cmd += jn("callId", static_cast<i64>(call_id));
    cmd += js("className", cls); cmd += js("methodName", m); cmd += js("signature", sig);
    cmd += jb("isStatic", is_static);
    cmd += jn("instanceHandle", static_cast<i64>(inst));
    cmd += jr("argsSpec", args_json.empty() ? "[]" : args_json);
    if (!mod_fields.empty()) cmd += jr("modifyInstanceFields", mod_fields);
    cmd += "}";
    return send(cmd);
}
