// ===========================================================================
// yam_java.cpp — JS bridge to libyamjs.a's embedded java-bridge
// ===========================================================================
// Architecture:
//   - The library has an embedded java-bridge listening on recv("cmd").
//   - We add a sibling listener on recv("yamgg_cmd") for our own cpp_* commands.
//   - Built-in commands (trace, pause, ...) still go via cmd.
//   - Our commands reply through a "reply" envelope; the bridge's events
//     come through as-is. We never replace recv("cmd").
// ===========================================================================

#include "yam_java_model.hpp"
#include "bootstrap_js.h"
#include "yam_internal.hpp"

namespace yam {

// ===========================================================================

// ===========================================================================
// SECTION 2 — JavaReplyParser
// ===========================================================================

bool JavaReplyParser::parse(const String& json, JavaReply& out) {
    auto r = JsonValue::parse(json);
    if (!r) return false;
    auto& j = r.value();
    if (!j.is_obj()) return false;
    if (auto* v = j.get("id"))     out.id = static_cast<u64>(v->as_i64(0));
    if (auto* v = j.get("ok"))     out.ok = v->as_bool(false);
    if (auto* v = j.get("error"))  out.error = v->as_str();
    if (auto* v = j.get("kind"))   out.kind = v->as_str();
    if (auto* v = j.get("handle")) out.handle = static_cast<u64>(v->as_i64(0));
    if (auto* v = j.get("result")) {
        if (v->is_str()) out.result = v->as_str();
        else out.result = v->stringify();
    }
    return true;
}

// ===========================================================================
// SECTION 3 — Bootstrap source (JS)
// ===========================================================================

namespace detail {

// yamgg_bootstrap::kBootstrapSrc lives in bootstrap_js.h (auto-generated)

} // namespace detail


// ===========================================================================
// SECTION 4 — JavaScriptBridge lifecycle
// ===========================================================================

JavaScriptBridge::JavaScriptBridge() = default;
JavaScriptBridge::~JavaScriptBridge() { if (ready_.load()) shutdown(); }

JavaScriptBridge& JavaScriptBridge::instance() {
    static JavaScriptBridge inst;
    return inst;
}

Result<void> JavaScriptBridge::initialize() {
    if (ready_.load()) return Result<void>::ok();
    script_ = Script::create("__yam_cpp_bootstrap__", yamgg_bootstrap::kBootstrapSrc);
    script_->set_message_handler([this](const Message& m) { on_message(m); });
    auto lr = script_->load();
    if (!lr) {
        YAM_LOG_ERROR() << "bootstrap load failed: " << lr.error_message();
        return Result<void>::err(ErrorCode::ScriptLoadFailed, lr.error_message());
    }
    i64 waited = 0;
    while (!ready_.load() && waited < 15000) {
        std::this_thread::sleep_for(std::chrono::milliseconds(10));
        waited += 10;
    }
    if (!ready_.load()) {
        YAM_LOG_WARN() << "bootstrap: no cpp_ready in 15s";
        return Result<void>::err(ErrorCode::Timeout, "cpp_ready not received");
    }
    YAM_LOG_INFO() << "js bridge ready";
    return Result<void>::ok();
}

Result<void> JavaScriptBridge::shutdown() {
    if (!script_) return Result<void>::ok();
    script_->clear_message_handler();
    script_->unload();
    script_.reset();
    ready_.store(false);
    return Result<void>::ok();
}

Result<void> JavaScriptBridge::send(const String& command_json) {
    if (!script_) return Result<void>::err(ErrorCode::NotInitialized, "no script");
    String wrapped = "{\"type\":\"cmd\",\"payload\":" + command_json + "}";
    script_->post(wrapped);
    return Result<void>::ok();
}

Result<JavaReply> JavaScriptBridge::call(const String& cmd_inner, i64 timeout_ms) {
    if (!script_)
        return Result<JavaReply>::err(ErrorCode::NotInitialized, "no script");

    u64    id     = 0;
    String action;
    {
        auto p = JsonValue::parse(cmd_inner);
        if (p && p.value().is_obj()) {
            if (auto* v = p.value().get("id"))     id     = static_cast<u64>(v->as_i64(0));
            if (auto* a = p.value().get("action")) action = a->as_str();
        }
    }
    if (id == 0) id = next_id_.fetch_add(1);

    // Routing:
    //   cpp_*    → yamgg_cmd  (our bootstrap, replies via "reply" envelope)
    //   others   → cmd         (embedded bridge, event-based, no sync wait)
    bool is_cpp = (action.size() >= 4 && action.compare(0, 4, "cpp_") == 0);

    if (!is_cpp) {
        String wrapped = "{\"type\":\"cmd\",\"payload\":" + cmd_inner + "}";
        script_->post(wrapped);
        JavaReply out;
        out.id = id; out.ok = true; out.kind = "void";
        return Result<JavaReply>::ok(std::move(out));
    }

    auto sync = std::make_shared<detail::JavaSync>();
    {
        std::lock_guard<std::mutex> lk(pending_mu_);
        pending_[id] = sync;
    }

    String wrapped = "{\"type\":\"yamgg_cmd\",\"payload\":" + cmd_inner + "}";
    script_->post(wrapped);
    sync->wait(timeout_ms);

    JavaReply out;
    {
        std::lock_guard<std::mutex> lk(pending_mu_);
        auto it = replies_.find(id);
        if (it == replies_.end()) {
            pending_.erase(id);
            return Result<JavaReply>::err(ErrorCode::Timeout,
                "reply timeout: " + action);
        }
        out = it->second;
        replies_.erase(it);
        pending_.erase(id);
    }
    if (!out.ok && !out.error.empty())
        return Result<JavaReply>::err(ErrorCode::InternalError, out.error);
    return Result<JavaReply>::ok(std::move(out));
}

void JavaScriptBridge::post_raw(const String& type, const JsonValue& payload) {
    if (!script_) return;
    JsonValue msg;
    msg.type = JsonValue::Type::Object;
    msg.obj_val["type"] = JsonValue(type);
    msg.obj_val["payload"] = payload;
    script_->post(msg.stringify());
}

void JavaScriptBridge::post_raw_json(const String& json) {
    if (script_) script_->post(json);
}

void JavaScriptBridge::on_message(const Message& m) {
    // The whole JSON message from JS.
    String raw = m.payload.empty() ? "" : m.payload;

    // frida's send() wraps: { "type": "send", "payload": {realEvent} }
    // Our bootstrap uses send({type:"cpp_ready",...}) which arrives as:
    //   { "type": "send", "payload": {"type":"cpp_ready",...} }
    auto parsed = JsonValue::parse(raw);
    if (!parsed) {
        YAM_LOG_WARN() << "bridge: bad JSON: " << raw;
        return;
    }
    auto& top = parsed.value();

    String type;
    if (auto* t = top.get("type")) type = t->as_str();

    // Unwrap frida's send() envelope.
    if (type == "send") {
        if (auto* inner = top.get("payload")) {
            // inner must be an object with a "type" field.
            if (inner->is_obj()) {
                on_event_json(*inner);
            } else {
                YAM_LOG_WARN() << "bridge: send payload not object";
            }
        }
        return;
    }

    // Direct message (no envelope).
    on_event_json(top);
}

void JavaScriptBridge::on_reply(const String& payload_json) {
    JavaReply reply;
    if (!JavaReplyParser::parse(payload_json, reply)) {
        YAM_LOG_WARN() << "bad reply: " << payload_json;
        return;
    }
    Ptr<detail::JavaSync> sync;
    {
        std::lock_guard<std::mutex> lk(pending_mu_);
        auto it = pending_.find(reply.id);
        if (it != pending_.end()) sync = it->second;
        replies_[reply.id] = reply;
    }
    if (sync) sync->notify();
}

void JavaScriptBridge::on_event_json(const JsonValue& ev) {
    String type;
    if (auto* t = ev.get("type")) type = t->as_str();
    if (type.empty()) return;

    if (type == "reply") {
        String payload;
        if (auto* p = ev.get("payload")) {
            if (p->is_str()) payload = p->as_str();
            else payload = p->stringify();
        }
        on_reply(payload);
        return;
    }

    if (type == "cpp_ready") {
        ready_.store(true);
        YAM_LOG_INFO() << "cpp bootstrap: ready";
        return;
    }
    if (type == "cpp_error") {
        String msg = "cpp bootstrap error";
        if (auto* v = ev.get("message")) msg = v->as_str(msg);
        YAM_LOG_ERROR() << msg;
        return;
    }
    if (type == "agent_ready") {
        YAM_LOG_INFO() << "embedded bridge: agent_ready";
    }
    if (type == "hook_cb") {
        HookCallback cb;
        { std::lock_guard<std::mutex> lk(cb_mu_); cb = hook_cb_; }
        if (cb) {
            i64 cb_id = 0; u64 this_h = 0;
            std::vector<u64> args;
            if (auto* v = ev.get("callbackId")) cb_id = v->as_i64(0);
            if (auto* v = ev.get("thisHandle")) this_h = static_cast<u64>(v->as_i64(0));
            if (auto* v = ev.get("argHandles")) {
                if (v->is_arr())
                    for (auto& a : v->arr_val) args.push_back(static_cast<u64>(a.as_i64(0)));
            }
            try { cb(cb_id, args, this_h); }
            catch (const std::exception& e) { YAM_LOG_ERROR() << "hook_cb: " << e.what(); }
        }
    }
    if (type == "console") {
        ConsoleCallback cb;
        { std::lock_guard<std::mutex> lk(cb_mu_); cb = console_cb_; }
        if (cb) {
            String level = "log", line;
            if (auto* v = ev.get("level")) level = v->as_str("log");
            if (auto* v = ev.get("line")) line = v->as_str();
            cb(level, line);
        }
    }
    if (type == "eval_result") {
        EvalCallback cb;
        { std::lock_guard<std::mutex> lk(cb_mu_); cb = eval_cb_; }
        if (cb) {
            u64 id = 0; bool ok = false; String result, error;
            if (auto* v = ev.get("id")) id = static_cast<u64>(v->as_i64(0));
            if (auto* v = ev.get("ok")) ok = v->as_bool(false);
            if (auto* v = ev.get("result")) result = v->is_str() ? v->as_str() : v->stringify();
            if (auto* v = ev.get("error")) error = v->as_str();
            cb(id, ok, result, error);
        }
    }
    Event e;
    e.type = type;
    e.data = ev;
    e.timestamp = time_util::now_ms();
    events::dispatch(e);
}

void JavaScriptBridge::set_hook_callback(HookCallback cb) {
    std::lock_guard<std::mutex> lk(cb_mu_);
    hook_cb_ = std::move(cb);
}
void JavaScriptBridge::set_console_callback(ConsoleCallback cb) {
    std::lock_guard<std::mutex> lk(cb_mu_);
    console_cb_ = std::move(cb);
}
void JavaScriptBridge::set_eval_callback(EvalCallback cb) {
    std::lock_guard<std::mutex> lk(cb_mu_);
    eval_cb_ = std::move(cb);
}

// ===========================================================================
// SECTION 5 — JavaScriptBridge command helpers
// ===========================================================================

namespace {
String js(const String& k, const String& v) {
    return ",\"" + k + "\":\"" + str::escape_json(v) + "\"";
}
String jn(const String& k, i64 v) {
    return ",\"" + k + "\":" + std::to_string(v);
}
String jr(const String& k, const String& raw) {
    return ",\"" + k + "\":" + raw;
}
String jb(const String& k, bool v) {
    return ",\"" + k + "\":" + (v ? "true" : "false");
}
String cmd_head(u64 id, const char* action) {
    return "{\"id\":" + std::to_string(id) + ",\"action\":\"" + action + "\"";
}
}

// ---------------------------------------------------------------------------
// Custom commands (reply-based)
// ---------------------------------------------------------------------------

Result<JavaReply> JavaScriptBridge::use_class(const String& cls) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_use_class") + js("className", cls) + "}");
}
Result<JavaReply> JavaScriptBridge::get_method(u64 c, const String& m, const String& s) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_get_method") +
                jn("classHandle", static_cast<i64>(c)) +
                js("methodName", m) + js("signature", s) + "}");
}
Result<JavaReply> JavaScriptBridge::cast(u64 c, u64 o) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_cast") +
                jn("classHandle", static_cast<i64>(c)) +
                jn("objectHandle", static_cast<i64>(o)) + "}");
}
Result<JavaReply> JavaScriptBridge::create_string(const String& v) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_create_string") + js("value", v) + "}");
}
Result<JavaReply> JavaScriptBridge::array_of(const String& t, const String& e) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_array_of") + js("elementType", t) +
                jr("elements", e.empty() ? "[]" : e) + "}");
}
Result<JavaReply> JavaScriptBridge::array_length(u64 h) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_array_length") + jn("handle", static_cast<i64>(h)) + "}");
}
Result<JavaReply> JavaScriptBridge::array_get(u64 h, usize i) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_array_get") +
                jn("handle", static_cast<i64>(h)) +
                jn("index", static_cast<i64>(i)) + "}");
}
Result<JavaReply> JavaScriptBridge::array_set(u64 h, usize i, const String& v) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_array_set") +
                jn("handle", static_cast<i64>(h)) +
                jn("index", static_cast<i64>(i)) +
                jr("value", v.empty() ? "null" : v) + "}");
}
Result<JavaReply> JavaScriptBridge::new_instance(u64 c, const String& a) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_new_instance") +
                jn("classHandle", static_cast<i64>(c)) +
                jr("args", a.empty() ? "[]" : a) + "}");
}
Result<JavaReply> JavaScriptBridge::release_handle(u64 h) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_release_handle") + jn("handle", static_cast<i64>(h)) + "}");
}
Result<JavaReply> JavaScriptBridge::list_handles() {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_list_handles") + "}");
}
Result<JavaReply> JavaScriptBridge::clear_handles() {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_clear_handles") + "}");
}
Result<JavaReply> JavaScriptBridge::inspect_handle(u64 h) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_inspect_handle") + jn("handleId", static_cast<i64>(h)) + "}");
}
Result<JavaReply> JavaScriptBridge::get_field_by_name(const String& cls, const String& f) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_get_field") +
                js("className", cls) + js("fieldName", f) + "}");
}
Result<JavaReply> JavaScriptBridge::snapshot_fields(u64 h) {
    return inspect_handle(h);
}
Result<JavaReply> JavaScriptBridge::retain(u64) {
    u64 id = next_id_.fetch_add(1);
    return call(cmd_head(id, "cpp_noop") + "}");
}

